{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "muND ES file (template, not decided)",
  "description": "A proposal for a file of the ES sub-library (energy spectra of emitted particles), made so that its pages can be designed before its format is decided. The envelope and the metadata are those of LT (schema/v1/lt.schema.json); only the entries differ. One entry is the spectrum of one particle from one target.",
  "type": "object",
  "properties": {
    "format": {"const": "muND/ES/draft"},
    "sublibrary": {"const": "ES"},
    "datasetType": {"$ref": "https://ribf.riken.jp/muon/schema/v1/lt.schema.json#/properties/datasetType"},
    "meta": {"$ref": "https://ribf.riken.jp/muon/schema/v1/lt.schema.json#/$defs/meta"},
    "data": {"type": "array", "items": {"$ref": "#/$defs/entry"}}
  },
  "required": ["format", "sublibrary", "datasetType", "meta", "data"],
  "additionalProperties": false,
  "$defs": {
    "entry": {
      "type": "object",
      "properties": {
        "datasetId": {
          "$ref": "https://ribf.riken.jp/muon/schema/v1/lt.schema.json#/$defs/id",
          "description": "DataID as for LT, with the particle in place of the key: ES|{DataSet}|{element}|{mass x 1000}|{MetaID}|{PARTICLE}."
        },
        "nuclide": {"$ref": "https://ribf.riken.jp/muon/schema/v1/lt.schema.json#/$defs/nuclide"},
        "observable": {
          "type": "object",
          "properties": {"kind": {"const": "spectrum"}, "spectrum": {"$ref": "#/$defs/spectrum"}},
          "required": ["kind", "spectrum"],
          "additionalProperties": false
        },
        "comment": {"$ref": "https://ribf.riken.jp/muon/schema/v1/lt.schema.json#/$defs/text"}
      },
      "required": ["datasetId", "nuclide", "observable"],
      "additionalProperties": false
    },
    "spectrum": {
      "type": "object",
      "properties": {
        "particle": {"enum": ["n", "p", "d", "t", "alpha"]},
        "energyUnit": {"const": "MeV"},
        "unit": {"const": "per capture per MeV"},
        "bins": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "low": {"type": "number", "minimum": 0},
              "high": {"type": "number", "exclusiveMinimum": 0},
              "value": {"type": "number", "minimum": 0},
              "uncertainty": {"type": "number", "minimum": 0, "description": "Optional. Total, one standard deviation."}
            },
            "required": ["low", "high", "value"],
            "additionalProperties": false
          }
        }
      },
      "required": ["particle", "energyUnit", "unit", "bins"],
      "additionalProperties": false
    }
  }
}

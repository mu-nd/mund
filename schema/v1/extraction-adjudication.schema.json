{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ribf.riken.jp/muon/schema/v1/extraction-adjudication.schema.json",
  "title": "muND extraction adjudication",
  "description": "extraction/<task>/adjudication.json: the result of comparing input A with input B - the adopted rows, the rows not adopted, the decisions on the source items - and its approval (docs/extraction.ja.md). The order of the properties below is the canonical key order of the file.",
  "type": "object",
  "properties": {
    "format": {"const": "muND/extraction-adjudication/1", "description": "Format identifier of this file."},
    "task": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$", "description": "id of the task."},
    "rows": {
      "type": "array",
      "description": "The adopted rows: the values to be published. a / b name the rows of input A / B they come from.",
      "items": {"$ref": "#/$defs/row"}
    },
    "excluded": {
      "type": "array",
      "description": "Rows of the inputs that are not adopted, with the reason.",
      "items": {
        "type": "object",
        "properties": {
          "a": {"$ref": "#/$defs/rowId"},
          "b": {"$ref": "#/$defs/rowId"},
          "reason": {"$ref": "#/$defs/text"},
          "by": {"$ref": "#/$defs/text"},
          "at": {"$ref": "#/$defs/text"}
        },
        "required": ["reason", "by", "at"],
        "additionalProperties": false
      }
    },
    "coverage": {
      "type": "array",
      "description": "Decisions on the source items the inputs did not mark alike.",
      "items": {
        "type": "object",
        "properties": {
          "item": {"$ref": "#/$defs/text"},
          "status": {"enum": ["covered", "no-data"]},
          "reason": {"$ref": "#/$defs/text"},
          "by": {"$ref": "#/$defs/text"},
          "at": {"$ref": "#/$defs/text"}
        },
        "required": ["item", "status", "reason", "by", "at"],
        "additionalProperties": false
      }
    },
    "approval": {
      "type": "object",
      "description": "Approval by the responsible person. It holds for the content whose hash it records; after any change it no longer holds (re-check needed).",
      "properties": {
        "by": {"$ref": "#/$defs/text"},
        "at": {"$ref": "#/$defs/text"},
        "contentHash": {"type": "string", "pattern": "^[0-9a-f]{64}$", "description": "SHA-256 of the approved content (docs/extraction.ja.md)."}
      },
      "required": ["by", "at", "contentHash"],
      "additionalProperties": false
    },
    "comment": {"$ref": "#/$defs/text"}
  },
  "required": ["format", "task", "rows"],
  "additionalProperties": false,
  "$defs": {
    "text": {"type": "string", "minLength": 1},
    "rowId": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$"},
    "row": {
      "type": "object",
      "properties": {
        "id": {"$ref": "#/$defs/rowId"},
        "a": {"$ref": "#/$defs/rowId", "description": "id of the row of input A (absent: none)."},
        "b": {"$ref": "#/$defs/rowId", "description": "id of the row of input B (absent: none)."},
        "adopted": {
          "enum": ["agreed", "A", "B", "other"],
          "description": "agreed: A and B are identical. A / B: that input's row. other: a corrected row."
        },
        "location": {
          "type": "object",
          "properties": {
            "page": {"$ref": "#/$defs/text"},
            "item": {"$ref": "#/$defs/text"},
            "label": {"$ref": "#/$defs/text"}
          },
          "required": ["item"],
          "additionalProperties": false
        },
        "nuclide": {
          "type": "object",
          "properties": {
            "element": {"type": "string", "pattern": "^[A-Z][a-z]?$"},
            "mass": {"type": "integer", "minimum": 0, "maximum": 300}
          },
          "required": ["element", "mass"],
          "additionalProperties": false
        },
        "kind": {"enum": ["lifetime", "capture_rate", "capture_probability"]},
        "conditions": {"type": "string", "pattern": "^[^\\s|]([^|]*[^\\s|])?$", "description": "Becomes the key of the published entry."},
        "original": {
          "type": "object",
          "properties": {
            "value": {"$ref": "#/$defs/text"},
            "unit": {"$ref": "#/$defs/text"},
            "uncertainty": {"$ref": "#/$defs/text"}
          },
          "additionalProperties": false
        },
        "value": {"type": "number"},
        "unit": {"enum": ["ns", "us", "us-1", "ms-1", "s-1", "%"]},
        "uncertainties": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "source": {"enum": ["total", "statistical", "systematic", "other"]},
              "value": {"type": "number", "minimum": 0}
            },
            "required": ["source", "value"],
            "additionalProperties": false
          }
        },
        "comment": {"$ref": "#/$defs/text", "description": "Becomes the comment of the published entry."},
        "reason": {"$ref": "#/$defs/text", "description": "Why this row was adopted (all but agreed)."},
        "by": {"$ref": "#/$defs/text", "description": "Who decided."},
        "at": {"$ref": "#/$defs/text", "description": "When (ISO 8601, UTC)."}
      },
      "required": ["id", "adopted", "location", "nuclide", "kind", "original", "value", "unit", "uncertainties"],
      "additionalProperties": false,
      "allOf": [
        {"if": {"properties": {"adopted": {"const": "agreed"}}, "required": ["adopted"]}, "else": {"required": ["reason", "by", "at"]}},
        {
          "if": {"properties": {"kind": {"const": "lifetime"}}, "required": ["kind"]},
          "then": {"properties": {"unit": {"enum": ["ns", "us"]}, "value": {"exclusiveMinimum": 0}}}
        },
        {
          "if": {"properties": {"kind": {"const": "capture_rate"}}, "required": ["kind"]},
          "then": {"properties": {"unit": {"enum": ["us-1", "ms-1", "s-1"]}}}
        },
        {
          "if": {"properties": {"kind": {"const": "capture_probability"}}, "required": ["kind"]},
          "then": {"properties": {"unit": {"enum": ["%"]}, "value": {"minimum": 0, "maximum": 100}}}
        }
      ]
    }
  }
}

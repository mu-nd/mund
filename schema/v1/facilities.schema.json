{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ribf.riken.jp/muon/schema/v1/facilities.schema.json",
  "title": "muND facility list",
  "description": "Master list of muon facilities and beam lines. Metadata records refer to an entry by its 'abbr'.",
  "type": "object",
  "properties": {
    "format": {"const": "muND/facilities/1"},
    "facilities": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "abbr": {"type": "string", "minLength": 1, "description": "Short name used in metadata records, e.g. 'J-PARC (D1)'. Must be unique."},
          "facility": {"type": "string", "minLength": 1, "description": "Laboratory, e.g. 'J-PARC'."},
          "detail": {"type": "string", "minLength": 1, "description": "Full name of the facility / beam line."}
        },
        "required": ["abbr", "facility", "detail"],
        "additionalProperties": false
      }
    }
  },
  "required": ["format", "facilities"],
  "additionalProperties": false
}

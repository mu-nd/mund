{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ribf.riken.jp/muon/schema/v1/constants.schema.json",
  "title": "muND physical constants",
  "description": "Physical constants used by the conversions.",
  "type": "object",
  "properties": {
    "format": {"const": "muND/constants/2"},
    "mu_plus_lifetime": {
      "type": "object",
      "description": "Mean lifetime of the free positive muon, in ns.",
      "properties": {
        "value": {"type": "number", "exclusiveMinimum": 0},
        "unit": {"const": "ns"},
        "source": {"type": "string", "minLength": 1}
      },
      "required": ["value", "unit", "source"],
      "additionalProperties": false
    }
  },
  "required": ["format", "mu_plus_lifetime"],
  "additionalProperties": false
}
